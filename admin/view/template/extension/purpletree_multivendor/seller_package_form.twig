<!DOCTYPE html>
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-attribute" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">{% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-attribute" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label">{{ entry_name }}</label>
            <div class="col-sm-10">
				<input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" class="form-control" />
				
				{% if error_name %}
				<div class="text-danger">{{ error_name }}</div>
				{% endif %}
            </div>
          </div>
		  <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_type }}</label>
			<div class="col-sm-10">
                <select name="type" id="input-type" class="form-control">
					<option value="0"></option>                  
					<option value="1" {% if type == '1' %}selected="selected"{% endif %}>Fixed</option>                  
					<option value="2" {% if type == '2' %}selected="selected"{% endif %}>Recurring</option>
				</select>
            </div>
          </div>
		  <div class="form-group" id="amount">
            <label class="col-sm-2 control-label">{{ entry_amount }}</label>
            <div class="col-sm-10">
				<input type="text" name="amount" value="{{ amount }}" placeholder="{{ entry_amount }}" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_commission }}</label>
            <div class="col-sm-10">
                <input type="text" name="commission" value="{{ commission }}" placeholder="{{ entry_commission }}" class="form-control" />
            </div>
          </div>
		  <div class="form-group" id="recurring-container">
            <label class="col-sm-2 control-label">{{ entry_recurring }}</label>
			<div class="col-sm-10">
                <select name="recurring_id" id="input-recurring" class="form-control">                  
					<option value="0"></option>
					{% for recurring in recurrings %}
					{% if recurring_id == recurring.plan_id %}
					  <option value="{{ recurring.plan_id }}" selected="selected">{{recurring.plan_name}}</option>
					{% else %}
					  <option value="{{ recurring.plan_id }}">{{recurring.plan_name}}</option>
					{% endif %}
					{% endfor %}
				</select>
              </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
    $(function(){
        $("select[name='type']").change(function(){
            $("#recurring-container").slideUp();
            $("#amount").slideDown();
            if($(this).val()==2){
                $("#recurring-container").slideDown();
                $("#amount").slideUp();
            }
        });
        $("select[name='type']").trigger('change');
    });
</script>
{{ footer }}
