{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-consumer-key">{{ entry_consumer_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_consumer_key" value="{{ shipping_usps_rest_consumer_key }}" id="input-consumer-key" class="form-control" />
              {% if error_consumer_key %}
              <div class="text-danger">{{ error_consumer_key }}</div>
              {% endif %}
              <p class="help-block">{{ help_consumer }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-consumer-secret">{{ entry_consumer_secret }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_consumer_secret" value="{{ shipping_usps_rest_consumer_secret }}" id="input-consumer-secret" class="form-control" autocomplete="off" />
              {% if error_consumer_secret %}
              <div class="text-danger">{{ error_consumer_secret }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-use-tem">{{ entry_use_tem }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_use_tem" id="input-use-tem" class="form-control">
                {% if shipping_usps_rest_use_tem %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
              <p class="help-block">{{ help_use_tem }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-origin-zip">{{ entry_origin_zip }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_origin_zip" value="{{ shipping_usps_rest_origin_zip }}" id="input-origin-zip" class="form-control" maxlength="10" />
              {% if error_origin_zip %}
              <div class="text-danger">{{ error_origin_zip }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-length">{{ entry_length }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_length" value="{{ shipping_usps_rest_length }}" id="input-length" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-width">{{ entry_width }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_width" value="{{ shipping_usps_rest_width }}" id="input-width" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-height">{{ entry_height }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_height" value="{{ shipping_usps_rest_height }}" id="input-height" class="form-control" />
              <p class="help-block">{{ help_dimensions }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-mail-class">{{ entry_mail_class }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_mail_class" value="{{ shipping_usps_rest_mail_class }}" id="input-mail-class" class="form-control" />
              <p class="help-block">{{ help_mail_class }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-weight-class">{{ entry_weight_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_weight_class_id" id="input-weight-class" class="form-control">
                <option value="0">{{ text_none }}</option>
                {% for wc in weight_classes %}
                {% if wc.weight_class_id == shipping_usps_rest_weight_class_id %}
                <option value="{{ wc.weight_class_id }}" selected="selected">{{ wc.title }}</option>
                {% else %}
                <option value="{{ wc.weight_class_id }}">{{ wc.title }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-tax-class">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_tax_class_id" id="input-tax-class" class="form-control">
                <option value="0">{{ text_none }}</option>
                {% for tax_class in tax_classes %}
                {% if tax_class.tax_class_id == shipping_usps_rest_tax_class_id %}
                <option value="{{ tax_class.tax_class_id }}" selected="selected">{{ tax_class.title }}</option>
                {% else %}
                <option value="{{ tax_class.tax_class_id }}">{{ tax_class.title }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_geo_zone_id" id="input-geo-zone" class="form-control">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                {% if geo_zone.geo_zone_id == shipping_usps_rest_geo_zone_id %}
                <option value="{{ geo_zone.geo_zone_id }}" selected="selected">{{ geo_zone.name }}</option>
                {% else %}
                <option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-debug">{{ entry_debug }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_debug" id="input-debug" class="form-control">
                {% if shipping_usps_rest_debug %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-display-weight">{{ entry_display_weight }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_display_weight" id="input-display-weight" class="form-control">
                {% if shipping_usps_rest_display_weight %}
                <option value="1" selected="selected">{{ text_yes }}</option>
                <option value="0">{{ text_no }}</option>
                {% else %}
                <option value="1">{{ text_yes }}</option>
                <option value="0" selected="selected">{{ text_no }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_usps_rest_status" id="input-status" class="form-control">
                {% if shipping_usps_rest_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_usps_rest_sort_order" value="{{ shipping_usps_rest_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
