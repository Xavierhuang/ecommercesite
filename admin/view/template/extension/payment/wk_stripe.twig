{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-layout" data-toggle="tooltip" title=" {{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
          <a href=" {{ cancel }}" data-toggle="tooltip" title=" {{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
   {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="alert alert-info"><i class="fa fa-exclamation-circle"></i> {{ text_info }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
     <div class="panel panel-default">
       <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i>{{ heading_title }}</h3>
        </div>
        <div class="panel-body">
         <form action="{{ action}}" method="post" enctype="multipart/form-data" id="form-layout"   class="form-horizontal">
           <div class="form-group">
             <label class="col-sm-2 control-label" for="input-status"> {{ entry_status }}</label>
             <div class="col-sm-10">
                   <select name="payment_wk_stripe_status" class="form-control">
                   {% if payment_wk_stripe_status %}
                   <option value="1" selected="selected"> {{ text_enabled }}</option>
                   <option value="0"> {{ text_disabled }}</option>
                   {% else %}
                   <option value="1"> {{ text_enabled }}</option>
                   <option value="0" selected="selected"> {{ text_disabled }}</option>
                   {% endif %}
                 </select>
             </div>
           </div>


          <ul class="nav nav-tabs">
           <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
           <li> <a href="#tab-stripe" data-toggle="tab">{{ tab_stripe }}</a></li>
           <li><a href="#tab-checkout" data-toggle="tab">{{ tab_checkout }}</a></li>
           <li><a href="#tab-status" data-toggle="tab">{{ tab_status }}</a></a></li>
           <li><a href="#tab-connect" data-toggle="tab">{{tab_connect }}</a></li>
           <li><a href="#tab-webhook" data-toggle="tab">{{ tab_webhook }}</a></a></li>
          <li><a href="#tab-wallet" data-toggle="tab">{{ tab_wallet }}</a></a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="tab-general">
             <div class="form-group required">
               <label class="col-sm-2 control-label" for="input-title"><span class="required" data-toggle="tooltip" title="{{ entry_title_info}} ">{{ entry_title }}</span></label>
               <div class="col-sm-10">
               {% for language in languages %}
                 <div class="input-group">
                  <span class="input-group-addon">
                   <img src="language/{{ language.code }}/{{ language.code }}.png" title="{{language['name']}}" />
                  </span>
                  <input type="text" class="form-control" name="payment_wk_stripe_title[{{language['language_id']}}]" value="{{payment_wk_stripe_title[language['language_id']]}}" />
                 </div>
                 {% if error_payment_wk_stripe_title[language.language_id] is defined and error_payment_wk_stripe_title[language.language_id] %}
                   <p class="text-danger">{{ error_payment_wk_stripe_title[language.language_id] }}</p>
                 {% endif %}
                 <br>
               {% endfor %}
               </div>
             </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order"> {{ entry_sort_order }}</label>
            <div class="col-sm-10"><input type="text" class="form-control" name="payment_wk_stripe_sort_order" value="{{ payment_wk_stripe_sort_order }}" size="1" /></div>
            </div>

          <div class="form-group">
           <label class="col-sm-2 control-label" for="input-total"> {{ entry_total }}</label>
            <div class="col-sm-10">
             <div class="input-group">
              <span class="input-group-addon">
               {{ entry_min }}
              </span>
              <input type="text" class="form-control" name="payment_wk_stripe_min" value="{{ payment_wk_stripe_min }}" placeholder=" {{ entry_min }}" onkeypress="return isNumber(event,$(this))"/>
                </div><br>
             <div class="input-group">
              <span class="input-group-addon">
                {{ entry_max }}
              </span>
              <input type="text" class="form-control" name="payment_wk_stripe_max" value="{{ payment_wk_stripe_max }}" placeholder=" {{ entry_max }}" onkeypress="return isNumber(event,$(this))"/>
             </div>
             {% if error_payment_wk_stripe_min %}
                <p class="text-danger"> {{ error_payment_wk_stripe_min }}</p>
                {% endif %}
             </div>
            </div>
            <div class="form-group">
             <label class="col-sm-2 control-label" for="input-geo-zone"> {{ entry_geo_zone }}<span data-toggle="tooltip" title="{{ entry_geo_zoneinfo  }}"> </span></label>
             <div class="scrollbox col-sm-10">
              <div class="well well-sm">
               <div class="even">
                <lable>
                 {% if 0 in payment_wk_stripe_zone %}
                  <input type="checkbox" name="payment_wk_stripe_zone[0]" value="0" checked="checked" />
                 {% else %}
                 <input type="checkbox" name="payment_wk_stripe_zone[0]" value="0" />
                {% endif %}
                  {{ text_all_zones }}
                </lable>
               </div>
               {% for geo_zone in geo_zones %}
                {% if not i %} {% set i=0 %}{% endif %}
              <div class="{% if i==0 %}{{ 'even' }} {% else %} {{'odd'}} {% set i= i - 1 %}{% endif %} checkbox"><label>
               {% if geo_zone['geo_zone_id'] in payment_wk_stripe_zone %}
                <input type="checkbox" name="payment_wk_stripe_zone[{{ geo_zone['geo_zone_id'] }}]" value="{{ geo_zone['geo_zone_id'] }}" checked="checked"/>
                 {% else %}
                <input type="checkbox" name="payment_wk_stripe_zone[{{ geo_zone['geo_zone_id'] }}]" value="{{ geo_zone['geo_zone_id'] }}"/>
                 {% endif %}
                 {{ geo_zone['name'] }}</label>
              </div>
               {% set i = i+1 %}
               {% endfor %}
              </div>
              <a class="selectAll">{{ "Select All" }}</a> &nbsp;&nbsp; <a
										class="deselectAll">{{ "Deselect All" }}</a>
             </div>
            </div>

            <div class="form-group">
             <label class="col-sm-2 control-label" for="input-groups"> {{ entry_groups }}<span data-toggle="tooltip" title="{{ entry_groupsinfo }}"> </span></label>
             <div class="scrollbox col-sm-10">
              <div class="well well-sm">
               <div class="checkbox">
                <label>
                 <div class="odd">
                   {% if 0 in payment_wk_stripe_customergroups %}
                    <input type="checkbox" name="payment_wk_stripe_customergroups[0]" value="0" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="payment_wk_stripe_customergroups[0]" value="0" />
                    {% endif %}
                     {{ text_all_customer }}
                  </div>
                </label>
                  {% for customer_group in customer_groups %} {% if not i %} {% set i=0 %} {% endif %}
                  <div class="{% if i==0 %}{{ 'even' }} {% else %} {{'odd'}} {% set i= i - 1 %}{% endif %} ">
                    <label>
                    {% if customer_group['customer_group_id'] in payment_wk_stripe_customergroups %}
                    <input type="checkbox" name="payment_wk_stripe_customergroups[{{ customer_group['customer_group_id'] }}]" value="{{customer_group['customer_group_id']}}" checked="checked"/>
                    {% else %}
                    <input type="checkbox" name="payment_wk_stripe_customergroups[{{ customer_group['customer_group_id']}}]" value="{{customer_group['customer_group_id']}}"/>
                      {% endif %}
                     {{ customer_group['name'] }}</label>
                  </div>
                  {% endfor %}
               </div>
                {% set i = i+1 %}
              </div>
              <a class="selectAll">{{ "Select All" }}</a> &nbsp;&nbsp; <a
										class="deselectAll">{{ "Deselect All" }}</a>
             </div>
            </div>
        </div>
         <div class="tab-pane" id="tab-stripe">
          <!-- {{ entry_keysinfo  }}-->
           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-stripe-mode"> <span class="required" data-toggle="tooltip" title=" {{ entry_stripe_mode_info  }}"> {{ entry_stripe_mode }}</span></label>
             <div class="col-sm-10">
                <select name="payment_wk_stripe_mode" class="form-control">
                {% if not payment_wk_stripe_mode %}
                  <option value="0" selected="selected">  {{ text_test }} </option>
                    {% else %}
                  <option value="0">  {{ text_test }} </option>
                  {% endif %}
                {% if payment_wk_stripe_mode %}
                  <option value="1" selected="selected">   {{ text_live }} </option>
                  {% else %}
                  <option value="1">  {{ text_live }} </option>
                  {% endif %}
                </select>
             </div>
           </div>
           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-test-key"> {{ entry_test_key }}</label>
             <div class="col-sm-10"><input type="text" class="form-control" name="payment_wk_stripe_test_key" value="{{ payment_wk_stripe_test_key }}" size="44"/>
              {% if error_payment_wk_stripe_test_key %}
                <p class="text-danger"> {{ error_payment_wk_stripe_test_key }}</p>
                {% endif %}
             </div>
           </div>
           <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-test-publish"> {{ entry_test_publish_key }}</label>
            <div class="col-sm-10"><input type="text" class="form-control" name="payment_wk_stripe_test_publish_key" value="{{ payment_wk_stripe_test_publish_key }}" size="44"/>
                {% if error_payment_wk_stripe_test_publish_key %}
                <p class="text-danger"> {{ error_payment_wk_stripe_test_publish_key }}</p>
                {% endif %}
            </div>
           </div>
           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-live-key"> {{ entry_live_key }}</label>
             <div class="col-sm-10"><input type="text" class="form-control" name="payment_wk_stripe_live_key" value="{{ payment_wk_stripe_live_key }}" size="44"/>
                {% if error_payment_wk_stripe_live_key %}
                <p class="text-danger"> {{ error_payment_wk_stripe_live_key }}</p>
                {% endif %}
             </div>
           </div>
           <div class="form-group required">
             <label class="col-sm-2 control-label" for="input-live-publish"> {{ entry_live_publish_key }}</label>
             <div class="col-sm-10"><input type="text" class="form-control" name="payment_wk_stripe_live_publish_key" value="{{ payment_wk_stripe_live_publish_key }}" size="44"/>
                {% if error_payment_wk_stripe_live_publish_key %}
                <p class="text-danger"> {{ error_payment_wk_stripe_live_publish_key }}</p>
                {% endif %}
             </div>
           </div>
           <div class="form-group">
              <label class="col-sm-2 control-label" for="input-curr-mapping"> {{ entry_currecny_mapping }}<span class="required" data-toggle="tooltip" title=" {{ entry_currecny_mappinginfo  }}">
              </span></label>
              <div class="col-sm-10">
                {% if currencies %}
                  {% for currencie in currencies %}
                  <div class="input-group">
                   <span class="input-group-addon">
                     {{ currencie['code'] }}</span>
                   <select class="form-control" name="payment_wk_stripe_currency[{{currencie['code']}}]">
                    <option value="0" selected >  {{ text_disabled }} </option>
                     {% for currencie2 in currencies %}
                       {% if payment_wk_stripe_currency[currencie['code']] and currencie2['code']==payment_wk_stripe_currency[currencie['code']] %}
                        <option value="{{ currencie2['code'] }}" selected >  {{ currencie2['code'] }} </option>
                        {% else %}
                        <option value="{{ currencie2['code'] }}" >  {{ currencie2['code'] }} </option>
                      {% endif %}
                    {% endfor %}
                   </select>
                  </div>
                  <br>
                  {% endfor %}
                {% endif %}
              </div>
           </div>
          </div>

         <div class="tab-pane" id="tab-checkout">
          <!-- {{ entry_stripe_settingsinfo  }}-->
             <div class="form-group">
               <label class="col-sm-2 control-label" for="input-shipping"> {{ entry_shipping }}<span class="required" data-toggle="tooltip" title=" {{ entry_shippinginfo  }}"></span></label>
               <div class="col-sm-10"><select name="payment_wk_stripe_shipping" class="form-control">
                  {% if not payment_wk_stripe_shipping %}
                  <option value="0" selected="selected"> {{ text_no }}</option>
                  {% else %}
                  <option value="0"> {{ text_no }}</option>
                  {% endif %}
                  {% if  payment_wk_stripe_shipping %}
                  <option value="1" selected="selected"> {{ text_yes }}</option>
                    {% else %}
                  <option value="1"> {{ text_yes }}</option>
                    {% endif %}
                </select>
               </div>
            </div>
        </div>

        <div class="tab-pane" id="tab-status">
          <!-- {{ entry_orderinfo  }}       -->
             <div class="form-group">
              <label class="col-sm-2 control-label" for="input-success"> {{ entry_successpayment }}</label>
              <div class="col-sm-10"><select name="payment_wk_stripe_success_status" class="form-control">
                {% for order_status in order_statuses %}
                 {% if order_status['order_status_id'] == payment_wk_stripe_success_status %}
                  <option value="{{ order_status['order_status_id'] }}" selected="selected"> {{ order_status['name'] }}</option>
                    {% else %}
                  <option value="{{ order_status['order_status_id'] }}"> {{ order_status['name'] }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
             </div>
          </div>

             <div class="form-group">
              <label class="col-sm-2 control-label" for="input-street"> {{ entry_streetchk }}</label>
             <div class="col-sm-10"><select name="payment_wk_stripe_addess_status" class="form-control">
               {% for order_status in order_statuses %}
                {% if order_status['order_status_id'] == payment_wk_stripe_addess_status %}
                  <option value="{{ order_status['order_status_id'] }}" selected="selected"> {{ order_status['name'] }}</option>
                    {% else %}
                  <option value="{{ order_status['order_status_id'] }}"> {{ order_status['name'] }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
             </div>
            </div>
             <div class="form-group">
              <label class="col-sm-2 control-label" for="input-zipchk"> {{ entry_zipchk }}</label>
              <div class="col-sm-10"><select name="payment_wk_stripe_zip_status" class="form-control">
                {% for order_status in order_statuses %}
                 {% if order_status['order_status_id'] == payment_wk_stripe_zip_status %}
                  <option value="{{ order_status['order_status_id'] }}" selected="selected"> {{ order_status['name'] }}</option>
                  {% else %}
                  <option value="{{ order_status['order_status_id'] }}"> {{ order_status['name'] }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>

            <div class="form-group">
             <label class="col-sm-2 control-label" for="input-cvcchk"> {{ entry_cvcchk }}</label>
             <div class="col-sm-10"><select name="payment_wk_stripe_cvc_status" class="form-control">
               {% for order_status in order_statuses %}
                {% if order_status['order_status_id'] == payment_wk_stripe_cvc_status %}
                  <option value="{{ order_status['order_status_id'] }}" selected="selected"> {{ order_status['name'] }}</option>
                  {% else %}
                  <option value="{{ order_status['order_status_id'] }}"> {{ order_status['name'] }}</option>
                  {% endif %}
                  {% endfor %}
                 </select>
             </div>
            </div>

            <div class="form-group">
             <label class="col-sm-2 control-label" for="input-refund"> {{ entry_refund }}</label>
             <div class="col-sm-10"><select name="payment_wk_stripe_refund_status" class="form-control">
              {% for order_status in order_statuses %}
               {% if order_status['order_status_id'] == payment_wk_stripe_refund_status %}
                <option value="{{ order_status['order_status_id'] }}" selected="selected"> {{ order_status['name'] }}</option>
                  {% else %}
                <option value="{{ order_status['order_status_id'] }}"> {{ order_status['name'] }}</option>
                  {% endif %}
                  {% endfor %}
              </select>
             </div>
            </div>
        </div>

        <div class="tab-pane" id="tab-connect">
        <div class="alert alert-info"><i class="fa fa-exclamation-circle"></i> {{entry_connect_info}}
              <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>

          <div class="form-group">
            <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_redirect_info}}">{{entry_connect_redirect}}</span></label>
            <div class="col-sm-9">
                <input type="text" readonly value="{{conn_url}}index.php?route=extension/payment/wk_stripe/stripeConnect" size="63" style="background:#f1f1f1;" class="form-control"/>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_test_client_id_info}}">{{entry_connect_test_client_id}}</span></label>
            <div class="col-sm-9">
                <input type="text" name="payment_wk_stripe_connect_test_client_id" value="{{payment_wk_stripe_connect_test_client_id}}"  class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_live_client_id_info}}">{{entry_connect_live_client_id}}</span></label>
            <div class="col-sm-9">
                <input type="text" name="payment_wk_stripe_connect_live_client_id" value="{{payment_wk_stripe_connect_live_client_id}}" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_type_info}}">{{entry_connect_type}}</span></label>
            <div class="col-sm-9">
                <select name="payment_wk_stripe_connect_type" class="form-control">
                  <option value="0"{% if payment_wk_stripe_connect_type %} {{ 'selected' }}{% endif %}>{{text_test }}</option>
                  <option value="1" {% if payment_wk_stripe_connect_type %}{{'selected'}}{% endif %}>{{ text_live }}</option>
                </select>
            </div>
        </div>


        <div class="form-group">
                <label class="col-sm-3 control-label">{{entry_connect_landing}}</label>
                <div class="col-sm-9">
                     <select name="payment_wk_stripe_connect_landing" class="form-control">
                        <option value="login" {% if payment_wk_stripe_connect_landing =='login'%} 'selected'}}{% endif %}>{{entry_connect_landing_login }}</option>
                        <option value="register" {% if payment_wk_stripe_connect_landing =='register'%} {{'selected'}}{% endif %}>{{entry_connect_landing_register}}</option>
                      </select>
                      <p id="alert-info" class="alert alert-info">{{ entry_connect_landing_info }}</p>
                </div>
            </div>

        <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
              <li><a href="#language{{language['language_id']}}" data-toggle="tab"><img {
               src="language/{{language['code']}}/{{language['code']}}.png" title="{{language['name']}}" /> {{language['name']}}</a></li>
            {% endfor %}
           </ul>

          <div class="tab-content">
            {% for language in languages %}

            <div class="tab-pane" id="language{{language['language_id']}}">
              <div class="form-group">
                <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_title_info}}">{{entry_connect_title}}</span></label>
                <div class="col-sm-9">
                 <div class="input-group">
                 <span class="input-group-addon"><img  src="language/{{language['code']}}/{{language['code']}}.png" title="{{language['name']}}" /></span>
                  <input type="text" name="payment_wk_stripe_connect_title[{{language['language_id']}}]" value="{% if payment_wk_stripe_connect_title[language['language_id']] %}{{payment_wk_stripe_connect_title[language['language_id']]}}{% endif %}" id="input-title{{language['language_id']}}" class="form-control" />
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-3 control-label"><span data-toggle="tooltip" title="{{entry_connect_description_info}}">{{entry_connect_description}}</span></label>
                <div class="col-sm-9">
                  <textarea name="payment_wk_stripe_connect_description[{{language['language_id']}}]" id="connectLanguage_{{language['language_id']}}" class="form-control"> {% if payment_wk_stripe_connect_description[language['language_id']] %} {{payment_wk_stripe_connect_description[language['language_id']]}} {% endif %}</textarea>
                </div>
              </div>
            </div><!--tab-pane-->
            {% endfor %}
            </div><!--language-sub-tab-content-->

        </div><!--connect-tab-->



      <!-- webhook -->
      <div class="tab-pane" id="tab-webhook">
        <div class="alert alert-info">{{ text_webhook_info }}</div>
        <!-- status -->
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_webhook_status }}</label>
            <div class="col-sm-10">
                  <select name="payment_wk_stripe_webhook_status" class="form-control">
                  {% if  payment_wk_stripe_webhook_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                   {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
                </select>
            </div>
          </div>

        <!-- webhook url -->
        <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_webhook_url }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                   <input type="text" class="form-control" id="webhook-url" value="{{ webhook_url }}" readonly />
                   <span class="input-group-addon" style="padding: 0;">
                    <button type="button" class="btn btn-primary" id="copy-webhook-btn"><i class="fa fa-copy"></i>&nbsp;{{ text_copy }}</button>
                 </span>
                </div>
           <style>
            .webhook-url-success {
                float: right;
                background: black;
                color: white;
                padding: 10px 15px;
                border-radius: 9px;
                margin-top: 5px;
                position: absolute;
                right: 27px;
                z-index: 1;
            }
            </style>
           <div class="webhook-url-success hide">{{ text_copied }}</div>
         </div>
        </div>

          <!-- webhook secret -->
          <div class="form-group required">
            <label class="col-sm-2 control-label">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input name="payment_wk_stripe_webhook_secret" type="text" class="form-control" value="{{ payment_wk_stripe_webhook_secret }}" placeholder="{{ entry_webhook_secret }}" />
              <div class="alert alert-info">{{ text_stripe_webhook_secret }}</div>
              {% if error_payment_wk_stripe_webhook_secret %}
                <div class="alert alert-danger">{{ error_payment_wk_stripe_webhook_secret }}</div>
              {% endif %}
            </div>
          </div>
        </div>

        <!-- webhook -->

        <div class="tab-pane" id="tab-wallet">
          <div class="alert alert-info">{{ text_wallet_info }}</div>
        </div>



      </div>
      </form>
    </div>
  </div>
</div>
<script type="text/javascript">
$('#language li a').tab('show');
</script>
<script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
<link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
<script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>
<script type="text/javascript"><!--
{% for language in languages %}
$('#connectLanguage_{{language['language_id']}}').summernote({height: 300});
{% endfor %}
function isNumber(evt,elem) {
  var data = $(elem).val();
  if((evt.charCode>= 48 && evt.charCode <= 57) || evt.charCode== 46 ||evt.charCode == 0){
    if(data.indexOf('.') > -1){
      if(evt.charCode== 46)
        evt.preventDefault();
    }
  }else
    evt.preventDefault();
}

$('.selectAll').on('click', function () {
  $(this).prev('div').find('input[type="checkbox"]').prop('checked', true);
})

$('.deselectAll').on('click', function () {
$(this).prevAll('div').find('input[type="checkbox"]').prop('checked', false);
})

$('#copy-webhook-btn').on('click', function(e){
  const elem = document.createElement('textarea');
  elem.value = $('#webhook-url').val();
  document.body.appendChild(elem);
  elem.select();
  document.execCommand('copy');
  document.body.removeChild(elem);
  e.preventDefault();
  $('.webhook-url-success').removeClass('hide');
  setTimeout(function(){
    $('.webhook-url-success').addClass('hide');
  }, 700)
});
