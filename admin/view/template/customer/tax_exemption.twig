{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
        <div class="pull-right">
          <form method="get" action="{{ action_filter }}" class="form-inline">
            <input type="hidden" name="user_token" value="{{ user_token }}" />
            <select name="filter_status" class="form-control">
              <option value="">{{ entry_status }}</option>
              <option value="pending" {{ filter_status == 'pending' ? 'selected' : '' }}>{{ text_status_pending }}</option>
              <option value="approved" {{ filter_status == 'approved' ? 'selected' : '' }}>{{ text_status_approved }}</option>
              <option value="rejected" {{ filter_status == 'rejected' ? 'selected' : '' }}>{{ text_status_rejected }}</option>
            </select>
            <button type="submit" class="btn btn-primary">{{ button_filter }}</button>
          </form>
        </div>
      </div>
      <div class="panel-body">
        {% if exemptions|length == 0 %}
        <p class="text-center">{{ text_no_results }}</p>
        {% else %}
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_customer }}</td>
                <td class="text-left">{{ column_email }}</td>
                <td class="text-left">{{ column_type }}</td>
                <td class="text-left">{{ column_cert_number }}</td>
                <td class="text-left">{{ column_state }}</td>
                <td class="text-left">{{ column_date_added }}</td>
                <td class="text-left">{{ column_status }}</td>
                <td class="text-right">{{ column_action }}</td>
              </tr>
            </thead>
            <tbody>
              {% for exemption in exemptions %}
              <tr>
                <td class="text-left">{{ exemption.customer_name }}</td>
                <td class="text-left">{{ exemption.email }}</td>
                <td class="text-left">{{ exemption.exemption_type }}</td>
                <td class="text-left">{{ exemption.certificate_number }}</td>
                <td class="text-left">{{ exemption.issuing_state }}</td>
                <td class="text-left">{{ exemption.date_added }}</td>
                <td class="text-left">
                  {% if exemption.status == 'pending' %}
                  <span class="label label-warning">{{ text_status_pending }}</span>
                  {% elseif exemption.status == 'approved' %}
                  <span class="label label-success">{{ text_status_approved }}</span>
                  {% else %}
                  <span class="label label-danger">{{ text_status_rejected }}</span>
                  {% endif %}
                </td>
                <td class="text-right">
                  {% if exemption.certificate_file %}
                  <a href="{{ catalog_url }}image/{{ exemption.certificate_file }}" target="_blank" class="btn btn-default btn-xs" data-toggle="tooltip" title="{{ text_view_certificate }}"><i class="fa fa-file"></i></a>
                  {% endif %}
                  {% if exemption.status == 'pending' %}
                  <a href="{{ approve_url }}{{ exemption.exemption_id }}" class="btn btn-success btn-xs" data-toggle="tooltip" title="{{ text_approve }}"><i class="fa fa-check"></i></a>
                  <button type="button" class="btn btn-danger btn-xs" data-toggle="modal" data-target="#reject-modal-{{ exemption.exemption_id }}" title="{{ text_reject }}"><i class="fa fa-times"></i></button>
                  <div class="modal fade" id="reject-modal-{{ exemption.exemption_id }}" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form method="post" action="{{ reject_url }}">
                          <input type="hidden" name="exemption_id" value="{{ exemption.exemption_id }}" />
                          <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                            <h4 class="modal-title">{{ text_reject }} - {{ exemption.customer_name }}</h4>
                          </div>
                          <div class="modal-body">
                            <div class="form-group">
                              <label for="reject-reason-{{ exemption.exemption_id }}">Reason (optional)</label>
                              <textarea name="rejection_reason" id="reject-reason-{{ exemption.exemption_id }}" class="form-control" rows="2"></textarea>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">{{ text_reject }}</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
