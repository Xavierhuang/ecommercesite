</style>
<script>
    // Configuration object for membership tiers
    const membershipConfig = {
        'platinum': {
            monthly: 'Platinum Membership',
            yearly: 'Platinum Membership Yearly',
            monthlyFee: '500',
            poPercentage: '5',
            annualFee: '5500'
        },
        'gold': {
            monthly: 'Gold Membership',
            yearly: 'Gold Membership Yearly',
            monthlyFee: '250',
            poPercentage: '14',
            annualFee: '2750'
        },
        'silver': {
            monthly: 'Silver Membership',
            yearly: 'Silver Membership Yearly',
            monthlyFee: '100',
            poPercentage: '15',
            annualFee: '1100'
        },
        'basic': {
            monthly: 'Basic Membership',
            monthlyFee: '0',
            poPercentage: '30'
        }
    };

    // Function to handle signup button clicks
    function handleSignup(tier, billingType) {
        // Get the membership name based on tier and billing type
        const membershipName = billingType === 'yearly'
            ? membershipConfig[tier].yearly
            : membershipConfig[tier].monthly;

        // Store membership details in localStorage
        localStorage.setItem('selectedMembership', membershipName);

        // Redirect to signup page
        window.location.href = 'https://diversiply.co/index.php?route=extension/account/purpletree_multivendor/sellerregister';
    }

    // Add click event listeners to all signup buttons when the DOM is loaded
    document.addEventListener('DOMContentLoaded', function () {
        // Get all savings badges (they contain the signup buttons)
        const savingsBadges = document.querySelectorAll('.savings-badge');

        savingsBadges.forEach(badge => {
            // Get the parent membership card to determine the tier
            const membershipCard = badge.closest('.membership-card');
            if (!membershipCard) return;

            // Determine the tier based on the card's class
            let tier = '';
            if (membershipCard.classList.contains('platinum')) tier = 'platinum';
            else if (membershipCard.classList.contains('gold')) tier = 'gold';
            else if (membershipCard.classList.contains('silver')) tier = 'silver';
            else if (membershipCard.classList.contains('baisc')) tier = 'basic'; // Note: keeping the typo from original HTML

            console.log('debut', {
                tier: tier,
                isMonthly: badge.className.includes('monthly'),
                isAnnually: badge.className.includes('annually'),
                isBasic: tier === 'basic'
            });

            // If this is a monthly billing badge
            if (badge.className.includes('monthly')) {
                badge.style.cursor = 'pointer';
                badge.addEventListener('click', () => handleSignup(tier, 'monthly'));
            }
            // If this is an annual billing badge
            else if (badge.className.includes('annually')) {
                badge.style.cursor = 'pointer';
                badge.addEventListener('click', () => handleSignup(tier, 'yearly'));
            }
            // For basic membership which only has "Sign up"
            else if (tier === 'basic') {
                badge.style.cursor = 'pointer';
                badge.addEventListener('click', () => handleSignup(tier, 'monthly'));
            }
        });

        // Add hover effect to savings badges
        const style = document.createElement('style');
        style.textContent = `
        .savings-badge {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .savings-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    `;
        document.head.appendChild(style);
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Only apply on mobile devices
        if (window.innerWidth <= 768) {
            const membershipCards = document.querySelectorAll('.membership-card');

            membershipCards.forEach(card => {
                const cardContent = card.querySelector('.card-content');
                const cardHeader = card.querySelector('.card-header');

                // Create toggle button
                const toggleButton = document.createElement('button');
                toggleButton.className = 'toggle-button';
                toggleButton.textContent = 'Show Benefits';

                // Insert button after header
                cardHeader.appendChild(toggleButton);

                // Add click handler
                toggleButton.addEventListener('click', () => {
                    const isExpanded = cardContent.classList.contains('expanded');

                    // Close all other cards first
                    document.querySelectorAll('.card-content').forEach(content => {
                        content.classList.remove('expanded');
                    });
                    document.querySelectorAll('.toggle-button').forEach(btn => {
                        btn.classList.remove('expanded');
                        btn.textContent = 'Show Benefits';
                    });

                    // Toggle current card
                    if (!isExpanded) {
                        cardContent.classList.add('expanded');
                        toggleButton.classList.add('expanded');
                        toggleButton.textContent = 'Hide Benefits';

                        // Scroll card into view with a small delay to allow animation
                        setTimeout(() => {
                            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }, 100);
                    }
                });

                // Initially collapse all cards
                cardContent.classList.remove('expanded');
            });

            // Add resize handler to reset states if screen size changes
            window.addEventListener('resize', () => {
                if (window.innerWidth > 768) {
                    document.querySelectorAll('.card-content').forEach(content => {
                        content.classList.remove('expanded');
                        content.style.maxHeight = '';
                    });

                    document.querySelectorAll('.toggle-button').forEach(btn => {
                        btn.style.display = 'none';
                    });
                }
            });
        }
    });
</script>
