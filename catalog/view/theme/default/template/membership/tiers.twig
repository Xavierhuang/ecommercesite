<style>
    :root {
        --primary-color: #ed5442;
        --emerald-500: #2dc787;
        --yellow-500: #F59E0B;
        --gray-400: #9CA3AF;
    }

    .main-bottom-text {
        font-size: 1.75rem;
        text-align: center;
        max-width: 800px;
        margin: 2rem auto;
        line-height: 1.4;
    }

    /* Container */
    .container {
        max-width: 1366px;
        width: auto;
        font-weight: 400 !important;
        font-size: 14px;
    }

    /* Hero Section */
    .hero-section {
        background-color: var(--primary-color);
        padding: 2rem;
        flex: 1;
        color: white !important;
        display: flex;
        flex-direction: row;
        justify-content: center;
        min-height: 150px;
    }

    .hero-content {
        background-color: var(--primary-color);
        padding: 2rem;
        flex: 1;
        color: white !important;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hero-content h1 {
        color: white !important;

    }



    .hero-image {
        flex: 1;
        background-image: url('https://diversiply.co/image/cache/catalog/Seller_22/BaduinLove-20211203015653-600x726.jpg');
        background-size: cover;
        background-position: center;
        min-height: 150px;
    }

    /* Membership Container */
    .membership-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
    }

    /* Membership Cards */
    .membership-card {
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border-bottom: 7px solid var(--primary-color);
        background-color: white;
        width: 100%;
    }

    .card-header {
        padding: 1.25rem;
        background: white;
    }

    .card-header h2 {
        margin: 0 0 0.5rem 0;
        color: var(--primary-color);
    }

    .price {
        color: #666;
        margin-bottom: 0.5rem;
    }

    .free-month {
        color: #666;
    }

    .free-month span {
        color: var(--emerald-500);
    }

    .benefit-title {
        color: var(--primary-color);
    }

    .savings-badge {
        background: var(--emerald-500);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0.5rem 0;
        width: 100%;
        box-sizing: border-box;
    }

    .savings-badge span {}

    .card-content {
        padding: 1.25rem;
        background-color: white;
    }

    /* Benefits List */
    .benefits-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .benefits-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 1rem;
        color: #666;
    }

    .check-icon {
        width: 20px;
        height: 20px;
        fill: var(--emerald-500);
        flex-shrink: 0;
        margin-top: 3px;
    }

    /* Services Section */
    .services-section {
        max-width: 1400px;
        padding: 1.5rem;
        text-align: center;
        background-color: #fbe3c7;
        margin: 2rem auto;
    }

    .services-section.title {
        color: var(--primary-color);
        font-size: 2rem;
    }

    .services-card {
        background: var(--emerald-500);
        color: white;
        padding: 1.5rem;
        border-radius: 25px;
        max-width: min(500px, 90%);
        margin: 0 auto;
    }

    .services-list {
        list-style: none;
        padding: 0;
    }

    .services-list li {
        display: flex;
