<footer>
	<div class="footer-top ">
	  <div class="container">
		<div class="container-inner">
		<div class="row">
			<div class="col1  col-md-4 col-sm-6 col-xs-12 col-footer">
				{% if block6 %}
					{{ block6 }}
				{% endif %}
				{% if block10 %}
					{{ block10 }}
				{% endif %}					
			</div>
			<div class="col2  col-md-2 col-sm-6 col-xs-12 col-footer">
				<div class="footer-title"><h5>{{ text_information }}</h5></div>
				<div class="footer-content">
					<ul class="list-unstyled text-content">
						{% if informations %}
					  {% for information in informations %}
					  <li><a href="{{ information.href }}">{{ information.title }}</a></li>
					  {% endfor %}
					  {% endif %}
					  <li><a href="{{ contact }}">{{ text_contact }}</a></li>
					  <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
					</ul>
				</div>
			</div>
			<div class="col3  col-md-2 col-sm-6 col-xs-12 col-footer">
				<div class="footer-title"><h5>{{ text_extra }}</h5></div>
				<div class="footer-content">
					<ul class="list-unstyled text-content">
						<li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
						<li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
						<li><a href="{{ special }}">{{ text_special }}</a></li>
						<li><a href="{{ order }}">{{ text_order }}</a></li>
						<li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
						<li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
					</ul>
				</div>
			</div>
			<div class="col4 col-md-4 col-sm-6 col-xs-12 col-footer">
				{% if block7 %}
					{{ block7 }}
				{% endif %}
				{% if block8 %}
					{{ block8 }}
				{% endif %}
			</div>
				
			  
			
		</div>
		</div>
	  </div>
	</div>
	
	<div class="footer-bottom ">
		<div class="container">
			<div class="container-inner">
				
				<div class="footer-copyright">
					<p>{{ powered }}</p>
				</div>
				{% if block9 %}
					{{ block9 }}
				{% endif %}
			</div>
		</div>
	</div>
	<div id="back-top"><i class="ion-ios-arrow-up"></i></div>
</footer>
<script>
$(document).ready(function(){
jQuery(".filter-price label span").html("Filter By Price");
	// hide #back-top first
	$("#back-top").hide();
	// fade in #back-top
	$(function () {
		$(window).scroll(function () {
			if ($(this).scrollTop() > $('body').height()/3) {
				$('#back-top').fadeIn();
			} else {
				$('#back-top').fadeOut();
			}
		});
		// scroll body to 0px on click
		$('#back-top').click(function () {
			$('body,html').animate({scrollTop: 0}, 800);
			return false;
		});
	});
});
jQuery(".col-footer:nth-child(3) ul li:nth-child(2), .col-footer:nth-child(3) ul li:nth-child(5)").html("Shop Now");
</script>
{% for script in scripts %}
<script src="{{ script }}" ></script>
{% endfor %}
